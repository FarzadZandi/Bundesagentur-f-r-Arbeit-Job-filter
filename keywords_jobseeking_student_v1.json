{
  "_meta": {
    "name": "B01-B10 job filter dictionary for Farzad Zandi (DE/EN)",
    "owner": "Farzad Zandi",
    "version": "1.7",
    "date": "2026-09-06",
    "scope": "Germany. Full-time roles and non-full-time early-career roles, limited to CV families B01-B10.",
    "normalization": "Lowercase; map ä→ae, ö→oe, ü→ue, ß→ss; collapse whitespace; strip HTML. Terms below are written mainly in normalized form.",
    "decision_order": [
      "employment_gate",
      "hard_exclusion",
      "kill_conditional",
      "relevance_gate",
      "cv_family classification",
      "score",
      "penalties and bonuses",
      "flags",
      "band"
    ],
    "scoring_rule": "Use ONLY the highest-scoring CV family as family_score so overlaps do not inflate results. Add each non-family group once when it has at least one hit, plus +1 per additional distinct hit, capped at 2x that group's base weight. title_boost is added once. Penalties/bonuses are additive.",
    "score_bands": {
      "PRIORITY": "final score >= 12 after all gates pass",
      "REVIEW": "final score 6 to 11 after all gates pass",
      "DE REQUIRED": "B01-B10 evidence passed but German C1/C2/native-level wording matched",
      "ACADEMISCHE": "explicit doctoral or otherwise uncertain academic-research role",
      "DROP": "a definite exclusion matched, such as a non-target employment format, excluded commercial profession, wrong profession without analytical evidence, or talking-centered marketing without research/analytics"
    },
    "important_rules": [
      "Sehr gute/verhandlungssichere/native-level German and C1/C2 German route a B01-B10 match to DE Required, except consulting roles, which are dropped when they require that level of German. B2/good German remains a penalty.",
      "Immatrikulation, Pflichtpraktikum, minimum remaining study time, visa/work-permit, EU citizenship and security-clearance wording are flags only. Do not infer legal eligibility from them.",
      "Recall-first relevance: a strong B01-B10 family match passes by itself. A weak family match passes only when paired with an analysis task or an English-language advertisement.",
      "Industries are not excluded. Exclusions are profession/title based and conditional so an analytics role in manufacturing, healthcare, finance or engineering can still pass.",
      "The dictionary and relevance gate intentionally favor recall. Extra false positives are acceptable because potentially suitable positions should not be silently omitted."
    ]
  },

